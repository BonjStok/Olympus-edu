# Olympus environment template. Copy to .env (never commit .env) and fill in what you need.
# Local `docker compose up -d --build` works with these values as they are: the teacher area and
# the evaluator API use the LOCAL-ONLY passwords below; there is no MAX sign-in without BOT_TOKEN
# and no code checking without JUDGE0_URL. Full reference: README.md, section 6; production:
# docs/DEPLOYMENT.md. No real tokens or production passwords belong in this file.

# development | production. compose.production.yaml forces production for the web service.
OLYMPUS_ENV=development
# Host port of the web app in local compose (http://localhost:3000).
OLYMPUS_PORT=3000
# Production only: domain without https://, used by Caddy (HTTPS) and the bot webhook URL.
OLYMPUS_DOMAIN=

# PostgreSQL 17. Docker Compose starts it automatically and passes these values to web and bot.
POSTGRES_DB=olympus
POSTGRES_USER=olympus
# Local default. Production: at least 16 characters and not this value; set it before the first
# start (changing it later does not change the password of an existing database).
POSTGRES_PASSWORD=olympus_local_dev
# Optional external PostgreSQL instead of the bundled one; takes precedence over DB_* settings.
DATABASE_URL=
# false | require | verify-full. Compose pins false for web and bot (bundled database).
DB_SSL=false

# Content seeding at container start: bootstrap (only into an empty DB), sync (update
# changed records, keep revisions) or off. Use bootstrap in production.
SEED_MODE=bootstrap

# Teacher (admin) password for «Я» → «Для учителя». The value below is for LOCAL checks only;
# production refuses to start with it (set your own, at least 12 characters). Empty: teacher
# login is disabled.
ADMIN_PASSWORD=olympus-local-admin

# MAX bot token (business.max.ru → Чат-боты → Настройки). Used by web to verify mini-app initData and
# by the bot. Empty: guest mode only, the bot runs in "disabled" mode. Required in production.
BOT_TOKEN=
# Olympiad reminders by the chat-bot: off | on (features.reminders in the app). Keep off until
# sending is agreed with MAX (MAX requirements, item 1.5).
BOT_REMINDERS=off
# Public MAX bot name for «Открыть в MAX» / share links in the app and the bot's open_app buttons
# (the bot of this project: https://max.ru/t605_hakaton_max_bot).
MAX_BOT_NAME=t605_hakaton_max_bot

# Evaluator API account (POST /api/v1/auth/login, role test_user). The password below is for
# LOCAL checks only; production refuses to start with it (set your own, at least 12 characters,
# and give it to evaluators separately). Empty password: /api/v1 answers 503 except /health.
TEST_API_USERNAME=test_user
TEST_API_PASSWORD=olympus-local-test

# Code checking: web -> runner -> Judge0 CE (docs/JUDGE0.md).
# Local compose defaults RUNNER_URL to http://runner:8080; production compose always sets it.
RUNNER_URL=
# Shared secret between web and runner. Optional locally, required in production.
RUNNER_TOKEN=

# Used only by the runner container. Judge0 CE is deployed separately; without JUDGE0_URL the
# runner stays healthy in "degraded" mode and code checks answer 503.
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
# Parallel code checks (1-16) and maximum runner request size in bytes.
RUNNER_MAX_CONCURRENT=4
RUNNER_REQUEST_LIMIT=1000000

# MAX chat-bot (bot/server.mjs, docs/BOT.md). Uses BOT_TOKEN above.
# Without BOT_TOKEN the bot container stays up in "disabled" mode (only /health).
# Update delivery: polling (local compose default), webhook (production default), off.
BOT_MODE=
# The bot's open_app buttons use MAX_BOT_NAME from the «MAX Mini App» block above
# (if it is empty, the bot takes its name from GET /me).
# Webhook: https URL on port 443 (production default https://$OLYMPUS_DOMAIN/max/webhook)
# and a secret of 5-256 characters A-Z a-z 0-9 _ - checked in X-Max-Bot-Api-Secret.
# The secret is required in webhook mode, i.e. in production.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
# Olympiad reminders are switched by BOT_REMINDERS in the «MAX Mini App» block above (keep off
# until MAX allows service messages: MAX requirements, item 1.5).
