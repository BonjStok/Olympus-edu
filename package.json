{
  "name": "olympus-school",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "compile-content": "node scripts/compile-content.mjs",
    "dev": "node scripts/compile-content.mjs && vinext dev --port 5173",
    "build": "node scripts/compile-content.mjs && vinext build",
    "start": "node scripts/docker-start.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project ui",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:api": "node scripts/api-smoke.mjs",
    "test:runner": "node scripts/runner-smoke.mjs",
    "db:migrate": "node scripts/postgres-migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:sync-content": "node scripts/sync-content.mjs",
    "db:setup": "node scripts/compile-content.mjs && node scripts/postgres-migrate.mjs && node scripts/seed.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "pg": "8.23.0",
    "wrangler": "4.136.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.3",
    "@cloudflare/workers-types": "5.20260922.1",
    "@eslint/js": "^10.0.1",
    "@maxhub/max-ui": "^0.5.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-orm": "0.45.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "prettier": "^3.9.8",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vinext": "1.0.0-beta.5",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
